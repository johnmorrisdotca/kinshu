{
  "name": "@johnmorrisdotca/kinshu",
  "version": "0.1.0",
  "description": "Kinshu 金種 — currency identity, minor units, cash breakdown, and the places each currency is legal tender. Zero dependencies.",
  "keywords": ["currency", "iso-4217", "cash", "denominations", "money", "typescript"],
  "license": "MIT",
  "author": "John Morris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kinshu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kinshu/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./minor": {
      "import": { "types": "./dist/minor.d.ts", "default": "./dist/minor.js" },
      "require": { "types": "./dist/minor.d.cts", "default": "./dist/minor.cjs" }
    },
    "./parts": {
      "import": { "types": "./dist/parts.d.ts", "default": "./dist/parts.js" },
      "require": { "types": "./dist/parts.d.cts", "default": "./dist/parts.cjs" }
    },
    "./breakdown": {
      "import": { "types": "./dist/breakdown.d.ts", "default": "./dist/breakdown.js" },
      "require": { "types": "./dist/breakdown.d.cts", "default": "./dist/breakdown.cjs" }
    },
    "./currency": {
      "import": { "types": "./dist/currency.d.ts", "default": "./dist/currency.js" },
      "require": { "types": "./dist/currency.d.cts", "default": "./dist/currency.cjs" }
    },
    "./places": {
      "import": { "types": "./dist/places.d.ts", "default": "./dist/places.js" },
      "require": { "types": "./dist/places.d.cts", "default": "./dist/places.cjs" }
    },
    "./bitcoin": {
      "import": { "types": "./dist/bitcoin.d.ts", "default": "./dist/bitcoin.js" },
      "require": { "types": "./dist/bitcoin.d.cts", "default": "./dist/bitcoin.cjs" }
    },
    "./history": {
      "import": { "types": "./dist/history.d.ts", "default": "./dist/history.js" },
      "require": { "types": "./dist/history.d.cts", "default": "./dist/history.cjs" }
    },
    "./cash/cad": {
      "import": { "types": "./dist/cash/cad.d.ts", "default": "./dist/cash/cad.js" },
      "require": { "types": "./dist/cash/cad.d.cts", "default": "./dist/cash/cad.cjs" }
    },
    "./cash/brl": {
      "import": { "types": "./dist/cash/brl.d.ts", "default": "./dist/cash/brl.js" },
      "require": { "types": "./dist/cash/brl.d.cts", "default": "./dist/cash/brl.cjs" }
    },
    "./cash/usd": {
      "import": { "types": "./dist/cash/usd.d.ts", "default": "./dist/cash/usd.js" },
      "require": { "types": "./dist/cash/usd.d.cts", "default": "./dist/cash/usd.cjs" }
    },
    "./cash/jpy": {
      "import": { "types": "./dist/cash/jpy.d.ts", "default": "./dist/cash/jpy.js" },
      "require": { "types": "./dist/cash/jpy.d.cts", "default": "./dist/cash/jpy.cjs" }
    },
    "./cash/gbp": {
      "import": { "types": "./dist/cash/gbp.d.ts", "default": "./dist/cash/gbp.js" },
      "require": { "types": "./dist/cash/gbp.d.cts", "default": "./dist/cash/gbp.cjs" }
    },
    "./cash/eur": {
      "import": { "types": "./dist/cash/eur.d.ts", "default": "./dist/cash/eur.js" },
      "require": { "types": "./dist/cash/eur.d.cts", "default": "./dist/cash/eur.cjs" }
    },
    "./cash/thb": {
      "import": { "types": "./dist/cash/thb.d.ts", "default": "./dist/cash/thb.js" },
      "require": { "types": "./dist/cash/thb.d.cts", "default": "./dist/cash/thb.cjs" }
    },
    "./cash/krw": {
      "import": { "types": "./dist/cash/krw.d.ts", "default": "./dist/cash/krw.js" },
      "require": { "types": "./dist/cash/krw.d.cts", "default": "./dist/cash/krw.cjs" }
    },
    "./cash/cny": {
      "import": { "types": "./dist/cash/cny.d.ts", "default": "./dist/cash/cny.js" },
      "require": { "types": "./dist/cash/cny.d.cts", "default": "./dist/cash/cny.cjs" }
    },
    "./cash/inr": {
      "import": { "types": "./dist/cash/inr.d.ts", "default": "./dist/cash/inr.js" },
      "require": { "types": "./dist/cash/inr.d.cts", "default": "./dist/cash/inr.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE.md"],
  "engines": { "node": ">=24" },
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-history.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "demo": "python3 -m http.server 8800 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/chizu": "1.5.1",
    "@johnmorrisdotca/hata": "1.7.2",
    "@johnmorrisdotca/kuni": "1.3.0",
    "esbuild": "0.27.7",
    "eslint": "^9.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": { "access": "public" },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
